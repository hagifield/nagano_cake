<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://kit.fontawesome.com/0e44a172cd.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="d-flex flex-column vh-100">
    <header class="shadow-sm">
     <nav class="navbar navbar-expand-lg navbar-light">
      
      <div class="container">
       
       <a class="navbar-brand p-3" href="/"><span>LOGO</span></a>
       
       <button class="navbar-toggler btn btn-light" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
       </button>
      
       <div class="collapse navbar-collapse" id="navbarNavDropdown">
        
        <% if customer_signed_in? %>
         
         <p class="mx-5">ようこそ、<%= current_customer.last_name %>さん!</p>
         
         <ul class = "navbar-nav ml-auto p-2" >
           <li class="nav-item">
            <%= link_to customer_path(current_customer), class:"btn btn-light" do %>
             <p>マイページ</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to items_path,class:"btn btn-light" do %>
             <p>商品一覧</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to cart_items_path,class:"btn btn-light" do %>
             <p>カート</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to destroy_customer_session_path, method: :delete,class:"btn btn-light" do %>
             <p>ログアウト</p>
            <% end %>
           </li>
         </ul>
        <% elsif admin_signed_in? %>
         <ul class="navbar-nav ml-auto p-2">
           <li class="nav-item mx-2">
            <%= link_to admin_items_path,class:"btn btn-light" do %>
             <p>商品一覧</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to admin_customers_path,class:"btn btn-light" do %>
             <p>会員一覧</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to admin_orders_path,class:"btn btn-light" do %>
             <p>注文一覧</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to admin_genres_path,class:"btn btn-light" do %>
            <p>ジャンル一覧</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to destroy_admin_session_path, method: :delete,class:"btn btn-light" do %>
             <p>ログアウト</p>
            <% end %>
           </li>
         </ul>
         
        <% else %>
         <ul class="navbar-nav ml-auto p-2">
           <li class="nav-item mx-2">
            <%= link_to homes_about_path,class:"btn btn-light" do %>
             <p>About</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to items_path,class:"btn btn-light" do %>
             <p>商品一覧</p>
            <% end %>
           </li>
           
           <li class="nav-item mx-2">
            <%= link_to new_customer_registration_path,class:"btn btn-light" do %>
             <p>新規登録</p>
            <% end %>
           </li>
           <li class="nav-item mx-2">
            <%= link_to new_customer_session_path,class:"btn btn-light" do %>
             <p>ログイン</p>
            <% end %>
           </li>
         </ul>
        <% end %>
        
       </div> <!-- collaps終了 -->
       
      </div><!-- containar class終了 -->
     </nav><!-- nav終了 -->
      
    </header>
    
    <main>
     <div class="container my-5 px-5 px-sm-0">
      <%= yield %>
     </div>
    </main>
    
    <footer class="bg-light text-white pt-5 pb-4">
     
    </footer>
    
    
  </body>
</html>
