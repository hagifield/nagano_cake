<% if @address.errors.any? %>
  <p><%= @address.errors.count %>件のエラーが発生しました</p>
  <ul>
    <% @address.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<h2>配送先編集</h2>

<div class="row">
  
  <div class="col-md-12">
    
    <%= form_with model: @address, local: true do |f| %>
      <table class="my-4">
        <tr>
          <th>郵便番号</th>
          <td><%= f.text_field :postal_code, value: @address.postal_code, autofocus: true %></td>
        </tr>
        
        <tr>
          <th>住所</th>
          <td><%= f.text_field :address, value: @address.address %></td>
        </tr>
        
        <tr>
          <th>宛名</th>
          <td><%= f.text_field :name, value: @address.name %></td>
          <td><%= f.submit "変更内容を保存", class:"btn btn-success" %></td>
        </tr>
      </table>
    <% end %>
    
  </div>
  
</div>

