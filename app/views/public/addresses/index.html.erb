<h2>配送先登録/一覧</h2>

<%= form_with model: @address, local: true do |f| %>
  <table>
    <tr>
      <th>郵便番号</th>
      <td><%= f.text_field :postal_code, placeholder: "0000000" %></td>
    </tr>
    
    <tr>
      <th>住所</th>
      <td><%= f.text_field :address, placeholder: "東京都渋谷区代々木神園町0-0" %></td>
    </tr>
    
    <tr>
      <th>宛名</th>
      <td><%= f.text_field :name, placeholder: "令和道子" %></td>
      <td><%= f.submit "新規登録" %></td>
    </tr>
  </table>
<% end %>


<table>
  <thead>
    <tr>
      <td>郵便番号</td>
      <td>住所</td>
      <td>宛名</td>
      <td colspan="2"></td>
    </tr>
  </thead>
  
  <% @addresses.each do |address| %>
    <tbody>
      <tr>
        <td><%= address.postal_code %></td>
        <td><%= address.address %></td>
        <td><%= address.name %></td>
        <td><%= link_to "編集する", edit_address_path(address) %></td>
        <td><%= link_to "削除する", address_path(address), method: :delete, data: { confirm: '本当に配送先を削除しますか？' } %></td>
      </tr>
    </tbody>
  <% end %>
</table>
