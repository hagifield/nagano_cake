<h1>Public::Orders#index</h1>
<p>Find me in app/views/public/orders/index.html.erb</p>

<h2>注文履歴一覧</h2>


<table>
  <thead>
    <tr>
      <th>注文日</th>
      <th>配送先</th>
      <th>注文商品</th>
      <th>支払金額</th>
      <th>ステータス</th>
      <th>注文詳細</th>
    </tr>
  </thead>
  
  <% @orders.each do |order| %>
    <tbody>
      <tr>
        <td><%= order.created_at.strftime('%Y/%m/%d') %></td>
        <td><%= order.postal_code %></br><%= order.address %></br><%= order.name %></td>
        <td></td>
        <td><%= order.charge %></td>
        <td><%= order.order_status %></td>
        <td></td>
      </tr>
    </tbody>
  <% end %>
  
</table>