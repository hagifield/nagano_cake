<h2 class="mx-3">注文履歴一覧</h2>

<div class="row">
  
  <div class="col-md-12">
    
    <table class="table table-borderd my-5">
      <thead class="table-secondary">
        <tr>
          <th>注文日</th>
          <th>配送先</th>
          <th>注文商品</th>
          <th>支払金額</th>
          <th>ステータス</th>
          <th>注文詳細</th>
        </tr>
      </thead>
      
      <% @orders.each do |order| %>
        <tbody>
          <tr>
            <td><%= order.created_at.strftime('%Y/%m/%d') %></td>
            <td><%= order.postal_code %></br><%= order.address %></br><%= order.name %></td>
            <td>
              <ul>
                <% order.order_details.each do |order_detail| %>
                  <li><%= order_detail.item.name %> - <%= order_detail.amount %> pcs</li>
                <% end %>
              </ul>
            </td>
            <td><%= order.charge %></td>
            <td><%= order.translated_order_status %></td>
            <td><%= link_to '表示する', order_path(order), class:"btn btn-primary" %></td>
          </tr>
        </tbody>
      <% end %>
      
    </table>
    
  </div>
  
</div>

