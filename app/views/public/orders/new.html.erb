<h2>注文情報入力</h2>

<%= form_with model: @order, local: true do |f| %>
  
  <h3><strong>支払い方法</strong></h3>
  <div>
    <%= f.radio_button :payment_method, :credit_card %>クレジットカード
  </div>
  <div>
    <%= f.radio_button :payment_method, :transfer %>銀行振込
  </div>
  
  <h3><strong>お届け先</strong></h3>
  <div>
    <%= f.radio_button :address_type, 'customer_address'  %>
    ご自身のご住所</br>
    <%= current_customer.postal_code %> <%= current_customer.address %></br>
    <%= current_customer.last_name %><%= current_customer.first_name %>
  </div>
  
  <div>
    <%= f.radio_button :address_type, 'registared_address' %>
    登録先住所から選択</br>
    <%= f.select :address_id, options_from_collection_for_select(Address.all, :id, :address_display) %>
  </div>
  
  <div>
    <%= f.radio_button :address_type, 'new_address' %>
    新しいお届け先</br>
    <table>
      <tr>
        <th>郵便番号</th>
        <td><%= f.text_field :new_postal_code %></td>
      </tr>
      
      <tr>
        <th>住所</th>
        <td><%= f.text_field :new_address %></td>
      </tr>
      
      <tr>
        <th>宛名</th>
        <td><%= f.text_field :new_name %></td>
      </tr>
    </table>
    
    <br>
    <%= f.submit "確認画面へ進む" %>
  </div>
  
<% end %>