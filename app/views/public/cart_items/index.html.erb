<div class="row">
  <div class="col-md-12">
    <div class="d-flex mb-3">
      <h2 class="me-auto">ショッピングカート</h2>
      <div class="ml-auto"><%= link_to "カートを空にする", destroy_all_cart_items_path, method: :delete, data: { confirm: '本当にカートを空にしますか？' }, class:"btn btn-danger" %></div>
    </div>
    
    <table class="table table-bordered table-hover">
      <thead class="table-secondary">
        <tr>
          <th>商品名</th>
          <th>単価（税込）</th>
          <th>数量</th>
          <th>小計</th>
          <th colspan="1"></th>
        </tr>
      </thead>
      
      <% @cart_items.each do |cart_item| %>
        <tbody>
          <tr>
            <td class="align-middle"><%= image_tag cart_item.item.get_cake_image(100,100) %><%= cart_item.item.name %></td>
            <td class="align-middle"><%= ((cart_item.item.price*1.1).floor).to_s(:delimited) %></td>
            <td class="align-middle">
              <%= form_with model: cart_item, local: true do |f| %>
                <%= f.select :amount, options_for_select((1..10).map { |n| [n, n] }, cart_item.amount) %>
                <%= f.submit "変更", class:"btn btn-success" %>
              <% end %>
            </td>
            <td class="align-middle"><%= ((cart_item.item.price*1.1 * cart_item.amount).floor).to_s(:delimited) %></td>
            <td class="align-middle"><%= link_to "削除する", cart_item_path(cart_item), method: :delete, data: { confirm: "本当に削除しますか？"}, class:"btn btn-danger" %></td>
          </tr>
        </tbody>
      <% end %>
    </table>
    
  </div>
</div>

<div class="row">
  <div class="col-md-2">
    <div>
      <%= link_to "買い物を続ける", root_path, class:"btn btn-primary text-nowrap" %>
    </div>
  </div>
  
  <div class="col-md-4 offset-md-6">
    <table class="table table-bordered ml-auto">
      <tr>
        <th class="table-secondary">合計金額</th>
        <td><%= @total_price.to_s(:delimited) %></td>
      </tr>
    </table>
  </div>
</div>  

<div class="d-flex justify-content-center">
  <% if @cart_items.any? %>
    <%= link_to "情報入力に進む", new_order_path, class:"btn btn-success" %>
  <% else %>
    <div><p>カートに商品がありません</p></div></br>
    <div><p><%= link_to "こちら",items_path %>から商品をカートに入れてください</p></div>
  <% end %>
</div>


