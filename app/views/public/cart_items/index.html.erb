<div>
  <h2>ショッピングカート</h2>
  <%= link_to "カートを空にする", destroy_all_cart_items_path, method: :delete, data: { confirm: '本当にカートを空にしますか？' } %>
</div>

<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価（税込）</th>
      <th>数量</th>
      <th>小計</th>
      <th colspan="1"></th>
    </tr>
  </thead>
  
  <% @cart_items.each do |cart_item| %>
    <tbody>
      <tr>
        <td><%= image_tag cart_item.item.get_cake_image(100,100) %><%= cart_item.item.name %></td>
        <td><%= ((cart_item.item.price*1.1).floor).to_s(:delimited) %></td>
        <td>
          <%= form_with model: cart_item, local: true do |f| %>
            <%= f.select :amount, options_for_select((1..10).map { |n| [n, n] }, cart_item.amount) %>
            <%= f.submit "変更" %>
          <% end %>
        </td>
        <td><%= ((cart_item.item.price*1.1 * cart_item.amount).floor).to_s(:delimited) %></td>
        <td><%= link_to "削除する", cart_item_path(cart_item), method: :delete, data: { confirm: "本当に削除しますか？"} %></td>
      </tr>
    </tbody>
  <% end %>
</table>

<%= link_to "買い物を続ける", root_path %>

<table>
  <tr>
    <th>合計金額</th>
    <td><%= @total_price.to_s(:delimited) %></td>
  </tr>
</table>


<h2>情報入力に進む</h2>
<%= link_to "情報入力に進む", new_order_path %>