<div class="col-md-2">
  <table class="table table-borderless border border-dark">
    <thead>
      <tr class="text-center">
        <th class="border-bottom border-dark">ジャンル検索</th>
      </tr>
    </thead>
  
    <% genres.each do |genre| %>
      <tbody>
        <tr>
          <th>
            <%= link_to one_genre_path(genre) do %>
              <%= genre.name %>
            <% end %>
          </th>
        </tr>
      </tbody>
    <% end %>
  </table>
</div>


