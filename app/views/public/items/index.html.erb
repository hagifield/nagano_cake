<%= render 'genre', genres: @genres %>

<h2>
    <% if params[:genre_id] %>
        <%= @genre.name %>一覧（全 <%= @genres_count %> 件）
    <% else %>
         商品一覧
    <% end %>
</h2>

<% @items.each do |item| %>
  <%= link_to item_path(item.id) do %>
    <div class="flex">
      <div class="flex-item">
        
        <div class="item-info">
          <%= image_tag item.get_cake_image(100,150) %>
        </div>
        
        <div class="item-info">
          <%= item.name %>
        </div>
        
        <div class="item-info">
          ¥<%= item.price.to_s(:delimited) %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<div>
  <%= paginate @items %>
</div>