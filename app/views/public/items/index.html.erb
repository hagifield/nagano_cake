    <div class="row">
      <%= render 'genre', genres: @genres %>
      
      <div class="col-md-9 offset-md-1">
        <h2>
          <% if params[:genre_id] %>
            <%= @genre.name %>一覧（全 <%= @genres_count %> 件）
          <% else %>
             商品一覧（全<%= @items_count %>件）
          <% end %>
        </h2>
        
        <div class="row">
          
        
          <% @items.each do |item| %>
            <div class="col-3">
              <%= link_to item_path(item.id) do %>
                <div class="flex">
                  <div class="flex-item">
                    
                    <div class="item-info">
                      <%= image_tag item.get_cake_image(100,150) %>
                    </div>
                    
                    <div class="item-info">
                      <h5><%= item.name %></h5>
                    </div>
                    
                    <div class="item-info">
                      <h6>¥<%= item.price.to_s(:delimited) %></h6>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        
          <div class="col-12 d-flex justify-content-center mt-4">
            <%= paginate @items, pagination_class: 'pagination p-2', link_options: { class: 'page-link mx-2' } %>
          </div>
        
        </div>
        
      </div>
      
    </div>

