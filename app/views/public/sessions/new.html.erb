<%= flash[:notice] %>

<div class="row">
  <div class="col-md-12">
    <h2 class="my-5">ログイン</h2>
    
    <h4 class="my-3">会員の方はこちらからログイン</h4>
    
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      
      <style>
        table tr th,
        table tr td {
          padding-bottom: 10px;
          padding-right: 30px;
        }
        
      </style>
      
      <table class="my-5">
        <tr>
          <th>メールアドレス</th>
          <td colspan="2">
            <%= f.email_field :email, autofocus: true, autocomplete: "email",class: "w-100" %>
          </td>
        </tr>
        
        <tr>
          <th>パスワード</th>
          <td colspan="2">
            <%= f.password_field :password, autocomplete: "current-password",class:"w-100" %>
          </td>
        </tr>
        
        <tr>
          <th></th>
          <td>
            <%= f.submit "ログイン", class: "btn btn-primary w-100" %>
          </td>
        </tr>
      </table>
      
    <% end %>
    
  </div>
</div>

<%= render "public/shared/links" %>
