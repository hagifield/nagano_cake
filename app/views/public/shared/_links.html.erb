<%- if controller_name != 'sessions' %>
  <div>
    <h4>既に登録済みの方</h4>
  </div>
  <div>
    <a><%= link_to "こちら", new_session_path(resource_name) %>からログインしてください</a>
  </div>
<% end %>



<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <div>
    <h4>会員登録がお済みでない方</h4>
  </div>
  <div>
    <a><%= link_to "こちら", new_registration_path(resource_name) %> から新規登録を行なってください</a>
  </div>  
<% end %>

