<h2 class="mx-4">商品詳細</h2>

<div class="row">
  <div class="col-md-3">
    <div><!-- 画像セクション -->
      <%= image_tag @item.get_cake_image(300,400),size: "200x200" %>
    </div>
  </div>
  
  <div class="col-md-8 offset-md-1">
    <style>
      
      table tr th,
      table tr td {
        padding-bottom:10px;
        padding-left:10px;
      }
      
    </style>
    <table class="mx-5 my-4">
      <tr>
        <th>商品名</th>
        <td><%= @item.name %></td>
      </tr>
      
      <tr>
        <th>商品説明</th>
        <td><%= @item.introduction %></td>
      </tr>
      
      <tr>
        <th>ジャンル</th>
        <td><%= @item.genre.name %></td>
      </tr>
      
      <tr>
        <th>税込価格</br>（税抜価格）</th>
        <td><%= ((@item.price*1.1).floor).to_s(:delimited) %>(<%= @item.price.to_s(:delimited) %>)</td>
      </tr>
      
      <tr>
        <th>販売ステータス</th>
        <td>
          <% if @item.is_active %>
            <strong class="text-success">販売中</strong>
          <% elsif %>
            <strong class="text-secondary">販売停止中</strong>
          <% end %>
        </td>
      </tr>
      
    </table>
  </div>
</div>



<div class="row">
  <div class="col-md-12 d-flex justify-content-center">
     <%= link_to "編集する", edit_admin_item_path, class:"btn btn-success" %>
  </div>
</div>