<div class="d-flex justify-content-between">
  
  <div><h2>商品一覧</h2></div>
  
  <div class="add_new_item">
    <%= link_to new_admin_item_path do %>
      <i class="fas fa-plus-circle fs-3" style="font-size: 200%;"></i>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    
    <table class="table my-4">
    
      <thead class="table-secondary">
        <tr>
          <td>商品ID</td>
          <td>商品名</td>
          <td>税抜価格</td>
          <td>ジャンル</td>
          <td>販売ステータス</td>
        </tr>
      </thead>
      
      <% @items.each do |item| %>
      <tbody>
        <tr>
          <td><%= item.id %></td>
          <td>
            <%= link_to admin_item_path(item.id) do %>
              <%= item.name %>
            <% end %>
          </td>
          <td><%= item.price %></td>
          <td><%= item.genre.name %></td>
          <td>
            <% if item.is_active %>
              <strong class="text-success">販売中</strong>
            <% elsif %>
              <strong class="text-secondary">販売停止中</strong>
            <% end %>
          </td>
        </tr>
      </tbody>
      
      <% end %>
      
    </table>
  
    
  </div>
</div>

<div class="row">
  <div class="col-12 d-flex justify-content-center mt-4">
    <%= paginate @items, pagination_class: 'pagination p-2', link_options: { class: 'page-link mx-2' } %>
  </div>
</div>


  


