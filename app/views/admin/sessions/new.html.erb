
<h2>管理者ログイン</h2>

<div class="row">
  <div class="col-md-7 d-flex justify-content-center">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    
    <style>
      
      table tr th,
      table tr td {
        padding-bottom:10px;
      }
      
    </style>
    
      <table class="my-4">
        <tr>
          <th>
            <%= f.label :email, "メールアドレス" %>
          </th>
          <td>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", size:"60x20" %>
          </td>
        </tr>
        
        <tr>
          <th>
            <%= f.label :password, "パスワード" %>
          </th>
          <td>
            <%= f.password_field :password, autocomplete: "current-password", size:"60x20" %>
          </td>
        </tr>
        
        <tr>
          <th></th>
          <td>
            <%= f.submit "ログイン", class:"btn btn-primary", size:"60x20" %>
          </td>
        </tr>
      </table>
    <% end %>
  </div>
</div>


  <div class="field">
    
  </div>

  <div class="field">
    
  </div>


  <div class="actions">

  </div>


<%= render "admin/shared/links" %>
