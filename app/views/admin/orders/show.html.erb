<h2 class="mx-4">注文履歴詳細</h2>

<div class="row">
  <div class="col-md-10">
    <style>
      table tr th,
      table tr td {
        padding:10px;
      }
    </style>
    <table class="my-5 ">
      <tr>
        <th><strong>購入者</strong></th>
        <td><%= (@order.customer.last_name)+(@order.customer.first_name) %></td>
      </tr>
      <tr>
        <th><strong>注文日</strong></th>
        <td><%= @order.created_at.strftime('%Y/%m/%d') %></td>
      </tr>
      <tr>
        <th><strong>配送先</strong></th>
        <td>〒<%= (@order.postal_code)+" "+(@order.address)%></br><%=(@order.name)%> </td>
      </tr>
      <tr>
        <th><strong>支払い方法</strong></th>
        <td><%= @order.translated_payment_method %></td>
      </tr>
      <tr>
        <th><strong>注文ステータス</strong></th>
        <%= form_with(model: [:admin, @order], url: admin_order_path(@order), method: :patch, local: true) do |f| %>
          <td>
            <%= f.select :order_status, Order.order_statuses.keys.map { |k| [t("enums.order.order_status.#{k}"), k]}, { selected: @order.order_status } %>
            <%= f.submit '更新', class: "btn btn-success mx-2" %>
          </td>
        <% end %>
        
      </tr>
    </table>
  </div>
</div>

<div class="row">
  <div class="col-md-9">
    <table class="table my-5">
      <thead class="table-secondary">
        <tr>
          <th>商品名</th>
          <th>単価（税込）</th>
          <th>数量</th>
          <th>小計</th>
          <th>製作ステータス</th>
        </tr>
      </thead>
      
      <% @order.order_details.each do |order| %>
        <tbody>
          <tr>
            <td><%= order.item.name %></td>
            <td><%= order.item.after_tax_price %></td>
            <td><%= order.amount %></td>
            <td><%= (order.charge).to_s(:delimited) %></td>
            <td>
              <%= form_with(model: order, url: admin_order_detail_path(order), method: :patch, local: true) do |f| %>
                <%= f.select :making_status, OrderDetail.making_statuses.keys.map{|k| [t("enums.order_detail.making_status.#{k}"), k]},{selected: order.making_status} %>
                <%= f.submit "更新", class:"btn btn-success mx-2" %>
              <% end %>
            </td>
          </tr>
        </tbody>
      <% end %>
    </table>
  </div>
  
  <div class="col-md-3">
      <table class="my-5">
        <tr>
          <th><strong>商品合計</strong></th>
          <td><%= @order.charge.to_s(:delimited) %></td>
        </tr>
        <tr>
          <th><strong>配送料</strong></th>
          <td>800</td>
        </tr>
        <tr>
          <th><strong>請求金額合計</strong></th>
          <td><%= ((@order.charge) + 800).to_s(:delimited) %></td>
        </tr>
      </table>
  </div>
  
</div>



