<h1>Admin::Orders#index</h1>
<p>Find me in app/views/admin/orders/index.html.erb</p>

<h2>
    <% if params[:customer_id] %>
        <%= @customer.full_name %>さんの注文履歴一覧
    <% else %>
         注文履歴一覧
    <% end %>
</h2>
<table>
    <thead>
        <tr>
            <th>購入日時</th>
            <th>購入者</th>
            <th>注文個数</th>
            <th>注文ステータス</th>
        </tr>
    </thead>
    
    <% @orders.each do |order| %>
        <tbody>
            <tr>
                <td>
                    <%= link_to admin_order_path(order.id) do %>
                        <%= order.created_at.strftime('%Y/%m/%d') %>
                    <% end %>
                </td>
                <td><%= (order.customer.last_name) + (order.customer.first_name) %></td>
                <td>
                    <%= order.order_details.sum(:amount) %>
                </td>
                <td><%= order.translated_order_status %></td>
            </tr>
        </tbody>
    <% end %>
    
</table>