<h2 class="mx-4">会員一覧</h2>

<div class="row">
  <div class="col-md-1"></div>
  <div class="col-md-10 d-flex justify-cntent-center">
    <table class="table">
      <thead class="table-secondary">
        <tr>
          <td>会員ID</td>
          <td>氏名</td>
          <td>メールアドレス</td>
          <td>ステータス</td>
        </tr>
      </thead>
      
      <% @customers.each do |customer| %>
      <tbody>
        <tr>
          <td><%= customer.id %></td>
          <td>
            <%= link_to admin_customer_path(customer.id) do %>
              <%= customer.last_name %><%= customer.first_name %>
            <% end %>
          </td>
          <td><%= customer.email %></td>
          <td>
            <% if customer.is_active %>
              <strong class="text-success">有効</strong>
            <% elsif %>
              <strong class="text-secondary">無効</strong>
            <% end %>
          </td>
        </tr>
      </tbody>
      <% end %>
        
      <tfoot>
        <tr>
          <%= paginate @customers,pagination_class: 'pagination p-2', link_options: { class: 'page-link mx-2' } %>
        </tr>
      </tfoot>
        
    </table>
  </div>
  <div class="col-md-1"></div>
</div>




