<h2 class="mx-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員詳細</h2>

<div class="row">
  <div class="col-md-12">
    <style>
      table tr th,
      table tr td {
        padding:10px;
      }
    </style>
    <table class="my-5">
      <tr>
        <th>会員ID</th>
        <td><%= @customer.id %></td>
      </tr>
      
      <tr>
        <th>氏名</th>
        <td><%= @customer.last_name %><%= @customer.first_name %></td>
      </tr>
      
      <tr>
        <th>フリガナ</th>
        <td><%= @customer.last_name_kana %><%= @customer.first_name_kana %></td>
      </tr>
      
      <tr>
        <th>郵便番号</th>
        <td><%= @customer.postal_code %></td>
      </tr>
      
      <tr>
        <th>住所</th>
        <td><%= @customer.address %></td>
      </tr>
      
      <tr>
        <th>電話番号</th>
        <td><%= @customer.telephone_number %></td>
      </tr>
      
      <tr>
        <th>メールアドレス</th>
        <td><%= @customer.email %></td>
      </tr>
      
      <tr>
        <th>会員ステータス</th>
        <td>
          <% if @customer.is_active %>
            <strong class="text-success">有効</strong>
          <% elsif %>
            <strong class="text-secondary">無効</strong>
          <% end %>
        </td>
      </tr>
      
      <tr>
        <th></th>
        <td><%= link_to "編集する", edit_admin_customer_path(@customer), class:"btn btn-success" %></td>
        <td><%= link_to "注文履歴一覧を見る", admin_customer_orders_path(@customer), class:"btn btn-primary" %></td>
      </tr>
    </table>
  </div>
</div>
