<h1>Admin::Customers#edit</h1>
<p>Find me in app/views/admin/customers/edit.html.erb</p>

<h2><%= @customer.last_name %><%= @customer.first_name %>さんの会員情報編集</h2>

<%= form_with model: [:admin, @customer], local: true do |f| %>
  <table>
    <tr>
      <th>会員ID</th>
      <td></td>
    </tr>
    
    <tr>
      <th>氏名</th>
    </tr>
    
    <tr>
      <th>フリガナ</th>
    </tr>
    
    <tr>
      <th>郵便番号</th>
    </tr>
    
    <tr>
      <th>住所</th>
    </tr>
    
    <tr>
      <th>電話番号</th>
    </tr>
    
    <tr>
      <th>メールアドレス</th>
    </tr>
    
    <tr>
      <th>会員ステータス</th>
    </tr>
    
    <tr>
      <th></th>
      <td><%= f.submit "変更を保存" %></td>
    </tr>
  </table>
<% end %>