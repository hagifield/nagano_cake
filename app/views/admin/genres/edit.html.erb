<% if @genre.errors.any? %>
  <p><%= @genre.errors.count %>件のエラーが発生しました</p>
  <ul>
    <% @genre.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<h2 class="mx-4">ジャンル編集</h2>


<%= form_with model: [:admin, @genre], local: true, method: :patch do |f| %>
  <style>
    .edit_this_genre tr th,
    .edit_this_genre tr td{
      padding:10px;
    }
  </style>
  <table class="my-5 edit_this_genre">
    <tr>
      <th>ジャンル名</th>
      <td><%= f.text_field :name, autofocus: true, value: @genre.name %></td>
      <td><%= f.submit "変更を保存", class:"btn btn-success" %></td>
    </tr>
  </table>
<% end %>